# 会话签名密钥，生产环境必须改成随机长字符串
# 生成：python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=please-change-me-to-a-random-32-plus-char-string

# 数据库（默认使用项目内 data/shop.db）
DATABASE_URL=sqlite:///data/shop.db

SHOP_NAME=PyShop 商城

# 初始管理员（仅首次初始化时创建）
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=admin123

# 可选：配置后 /api/products/{id}/pitch 会调用大模型，否则使用内置文案
LLM_API_KEY=
LLM_BASE_URL=https://api.deepseek.com/v1
LLM_MODEL=deepseek-chat
